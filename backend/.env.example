# ── Database ───────────────────────────────────────────────
# Matches docker-compose.yml: postgres service (port 5432, password "secret")
DATABASE_URL=postgresql://healthlink:secret@localhost:5432/healthlink_db
TEST_DATABASE_URL=postgresql://healthlink:secret@localhost:5432/healthlink_test

# ── Redis ──────────────────────────────────────────────────
# Matches docker-compose.yml: redis service (host port 6380 → container 6379)
REDIS_URL=redis://localhost:6380/0

# ── JWT ────────────────────────────────────────────────────
# Change this to a long random string in production!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_BOOKING=booking_events
KAFKA_TOPIC_QUEUE=queue_events
KAFKA_TOPIC_NOTIFICATIONS=notification_events

# ── ML Model Paths ─────────────────────────────────────────
MODEL_NOSHOW_PATH=./apps/ml/models/noshow_model.pkl
MODEL_WAITTIME_PATH=./apps/ml/models/waittime_model.pkl
MODEL_RELIABILITY_CSV=./apps/ml/models/reliability_grades.csv

# ── Notifications (optional for dev) ──────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ── App ────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
